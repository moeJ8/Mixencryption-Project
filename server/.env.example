PORT=5000
NODE_ENV=development

# Comma-separated browser origins (Vercel + local). CLIENT_ORIGIN is a single-origin alias.
CLIENT_ORIGIN=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

MONGO_URI=
JWT_SECRET=

# Google OAuth (optional). Redirect URI must match Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# App links in emails (defaults to CLIENT_ORIGIN)
# CLIENT_APP_URL=http://localhost:5173

# Email (Nodemailer). Leave SMTP_* empty in dev: links are printed in the API console.
#
# Option A — no real mail (local dev): leave blank, copy links from server logs.
#
# Option B — project-only Gmail: create a new Google account for MixEncryption, then App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=mixencryption.project@gmail.com
# SMTP_PASS=
# SMTP_FROM=mixencryption.project@gmail.com
#
# Option C — Brevo (free tier, not your personal inbox): https://www.brevo.com
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=verified-sender@yourdomain.com
#
# Option D — Resend SMTP: https://resend.com (verify domain or use their onboarding sender)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxx
# SMTP_FROM=onboarding@resend.dev

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=MixEncryption

# Cloudinary (profile photos). https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_AVATAR_FOLDER=mixencryption/avatars
